# Google OAuth client (Desktop app type) from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From `npm run token` (read-only Gmail access)
GOOGLE_REFRESH_TOKEN=
# Password for the site (browser asks for it once per device). Username can be anything.
APP_PASSWORD=

# Optional: turns on the "Analyze with Claude" section. Leave empty to keep it off.
# Get a key at https://console.anthropic.com (billed per use, separate from a Claude Pro plan).
ANTHROPIC_API_KEY=
